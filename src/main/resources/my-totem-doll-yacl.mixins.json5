{
    "required": true,
    "package": "net.lopymine.mtd.mixin.yacl",
    "refmap": "${mod_id}.refmap.json",
    "compatibilityLevel": "JAVA_${java}",
	"plugin": "net.lopymine.mtd.compat.yacl.YACLCompatPlugin",
    "mixins": [
    ],
	"client": [
		"ScreenMixin",
		"YACLScreenMixin",
		"YetAnotherConfigLibImplBuilderMixin",
		"YetAnotherConfigLibImplMixin",
		"category.ConfigCategoryImplBuilderImplMixin",

		"widget.ListEntryWidgetMixin",
	    "widget.AbstractWidgetMixin",
	    "widget.OptionDescriptionWidgetMixin",
		"widget.EditBoxMixin",
		"category.AbstractScrollAreaMixin",
		"category.ItemInHandRendererMixin",
		"widget.AbstractButtonMixin"
	],
    "injectors": {
        "defaultRequire": 1
    }
}